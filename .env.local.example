# Example environment variables for local development
# Copy this file to .env.local and replace values with real ones.

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
# Do NOT commit your real production keys to version control.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional: Google Tag Manager container ID (if you use GTM instead)
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# NODE_ENV is normally set by your environment (development/production)
# but you can override it locally if needed.
# NODE_ENV=development

# Examples of other environment variables you might add:
# NEXT_PUBLIC_API_URL=https://api.example.com
# SECRET_SOME_KEY=your-secret-value (DO NOT commit secrets)
